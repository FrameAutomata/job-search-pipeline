# Path to your resume PDF — read by filter step (future: keyword extraction)
RESUME_PATH=./resumes/resume.pdf

# Path to the career-ops install. Defaults to ./career-ops (created by setup script).
# Point this elsewhere if you already have career-ops cloned somewhere.
CAREER_OPS_PATH=./career-ops

# Path to the search config (YAML). Defaults to ./config/search.yml.
SEARCH_CONFIG=./config/search.yml

# CLI used by --batch evaluation. Use whichever agent CLI you prefer.
# Supported values: claude, opencode, gemini, qwen
BATCH_CLI=claude

# Model passed to the CLI via --model. Leave unset to use the CLI's own default.
# The model must support tool-calling — the agent reads and writes files as part of
# the evaluation. Without tool use the evaluation will be incomplete.
# OLLAMA_MODEL=qwen2.5:32b

# ── Batch evaluation (--evaluate-batch) ──
# Provider for --evaluate-batch. Auto-detected from API keys below if not set.
# Options: anthropic | gemini | openai | groq | deepinfra | openrouter | ollama
# Auto-detect order (cheapest first): gemini → groq → deepinfra → openrouter
#                                     → openai → anthropic
# BATCH_PROVIDER=deepinfra

# Model name. Defaults to the provider's recommended model if not set.
# After changing any model below, run `python -m pipeline.verify_models` to
# confirm each configured ID still exists in its provider's catalog — a stale
# model ID fails silently at call time.
#
# IMPORTANT for Gemini free-tier users: per-model RPD (requests/day ≈ jobs/day)
# varies a lot. Check yours at https://aistudio.google.com/rate-limit. Free-tier
# caps as of mid-2026 (see pipeline/gemini_limits.py — the batch run warns if a
# run would exceed them):
#   gemini-2.5-flash       =  20 RPD   (too low for >20 jobs/day)
#   gemini-3.5-flash       =  20 RPD
#   gemini-3.1-flash-lite  = 500 RPD
#   gemma-4-31b-it         = 1.5K RPD
#   gemma-4-26b-a4b-it     = 1.5K RPD  ← best for batch evaluations
# For a 200+ job daily run, override the default:
#   BATCH_MODEL=gemma-4-26b-a4b-it
# BATCH_MODEL=gemini-2.5-flash

# Gemini free-tier conforming. When true, evaluation + résumé tailoring pace
# requests to the model's RPM and each eval run caps to its RPD (deferring the
# rest to the next run), so you stay within the free tier instead of 429-ing.
# No-op for paid models / other providers. The Setup wizard sets this.
# GEMINI_FREE_TIER=false

# Parallel workers for --evaluate-batch (default: 3).
# Lower for providers with strict rate limits; higher for paid tiers.
# BATCH_CONCURRENCY=3

# Anthropic — for --evaluate-batch with provider=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — free tier available on gemini-2.5-flash and similar models.
# gemini-2.0-flash is deprecated (shutdown 2026-06-01) and effectively NOT
# on the free tier — leave BATCH_MODEL unset to get the working default.
# GEMINI_API_KEY=AIza...

# OpenAI
# OPENAI_API_KEY=sk-...

# Escape hatch: point the openai provider at any OpenAI-compatible endpoint
# (local vLLM server, internal proxy, or any provider we haven't added
# explicitly above). Leave unset to use OpenAI's default api.openai.com.
# OPENAI_BASE_URL=https://my-internal-proxy.example.com/v1

# DeepInfra — hosted open-weight models (Llama, DeepSeek, Qwen, Mistral)
# served via OpenAI-compatible API. Sign up at https://deepinfra.com
# DEEPINFRA_API_KEY=...

# OpenRouter — meta-aggregator routing to many providers behind one API.
# Useful for A/B testing different models without re-doing setup.
# Sign up at https://openrouter.ai
# OPENROUTER_API_KEY=sk-or-...

# Groq — free tier with fast inference on open-source models.
# Tight TPM limit on the free tier makes it best for small runs.
# GROQ_API_KEY=gsk_...

# Ollama — local models, no API key needed (install ollama.com).
# Only viable for local runs — GHA workflow can't reach localhost.
# OLLAMA_BASE_URL=http://localhost:11434

# ── Triage UI: career-ops skills (resume tailoring, etc.) ──
# When you run a skill from the UI you can use the API (provider keys above) or
# your agent CLI (BATCH_CLI above). Default below decides which the UI uses:
#   ask = let you choose each time (recommended) | api = always API | cli = always CLI
# Useful if you'd rather spend an agent-CLI membership than API credits, or mix
# (API for batch scoring, CLI for tailoring). Defaults to "ask".
# SKILL_PATH_DEFAULT=ask

# Path to the GitHub CLI (`gh`). Normally the UI auto-resolves it via PATH
# (shutil.which honors PATHEXT). Set this only if auto-resolution fails — e.g.
# when gh ships as a Microsoft Store "App Execution Alias" that CreateProcess
# can't follow, or the UI was launched from an environment without gh on PATH.
# Windows example:
# GH_BIN=C:\Program Files\GitHub CLI\gh.exe

# ── Auto-apply: off-site ATS account credentials (LOCAL ONLY) ──
# Used by the agentic apply engine to sign into / create accounts on employer
# ATS (Greenhouse, Lever, Workday, …) and to read email verification codes.
# These are real, reused secrets — they live ONLY in this local .env (never in
# profile.yml / GitHub Secrets) and auto-apply never runs in the cloud.
#
# The "single shared email" used for ATS accounts AND the verification inbox.
# Defaults to your candidate email (career-ops/config/profile.yml) if unset.
# APPLY_ATS_EMAIL=you@example.com
# Password the agent uses to log into / create ATS accounts.
# APPLY_ATS_PASSWORD=your-ats-password
# IMAP inbox the verification reader polls (host + app-password; username is the
# email above). Gmail: imap.gmail.com + a 16-char App Password (not your login).
# Without all three (email + host + password) email verification is skipped.
# APPLY_IMAP_HOST=imap.gmail.com
# APPLY_IMAP_PORT=993
# APPLY_IMAP_PASSWORD=your-imap-app-password
