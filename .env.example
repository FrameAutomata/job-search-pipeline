# Path to your resume — read by the filter step for keyword extraction.
# Accepts DOCX, ODT, or PDF. DOCX/ODT are recommended: resume tailoring slot-edits
# an editable copy per job from a DOCX, and editable formats extract more cleanly
# than a PDF. Leave this unset to auto-discover resumes/resume.{pdf,docx,odt};
# set it only to point at a file elsewhere or with a non-default name.
# RESUME_PATH=./resumes/resume.docx

# Path to the career-ops install. Defaults to ./career-ops (created by setup script).
# Point this elsewhere if you already have career-ops cloned somewhere.
CAREER_OPS_PATH=./career-ops

# Path to the search config (YAML). Defaults to ./config/search.yml.
# Local runs auto-prefer config/search.local.yml when it exists (create/edit it
# from the UI's "Edit local search config"), so you can search different terms
# locally than the cloud daily. This SEARCH_CONFIG line stays at the shared
# default and does NOT override that; point it at some *other* file only if you
# deliberately want a custom config to win over the local override.
SEARCH_CONFIG=./config/search.yml

# ── Agent CLI: the one that applies for you and runs --batch ──
# The free options come first. One line per CLI: id, tier, what you get.
# (pipeline/agent_cli.py is the source of truth; a test keeps this list equal
# to it.) The Setup wizard writes this key too.
#   opencode  free   OpenCode — Zen's rotating free hosted models (no key), or your own Gemini API key at the API free tier; paid keys plug into the same CLI
#   agy       free   Antigravity CLI — Google's successor to Gemini CLI for individuals; a small WEEKLY quota (a few applications a week)
#   gemini    free   Gemini CLI — with a GEMINI_API_KEY from AI Studio at the API free tier (personal logins ended 2026-06-18); launched with -m gemini-3.1-flash-lite (~500 req/day)
#   claude    paid   Claude Code — Pro subscription or API credits; the strongest at browser work
#   qwen      paid   Qwen Code — free login ended 2026-04-15
BATCH_CLI=opencode

# The model the agent CLI above is started with, on both paths: the hand-off
# command (Hand off, career skills, Run in terminal) renders it as the CLI's
# own flag — opencode `--model` in provider/model form (e.g.
# google/gemini-3.1-flash-lite with your Gemini key), gemini/qwen `-m`, claude
# and agy `--model` — and `--batch` forwards it as batch-runner's --model
# (unless OLLAMA_MODEL below is set, which wins there). Leave unset and each
# CLI starts on its own default — except gemini, which gets
# gemini-3.1-flash-lite (~500 requests/day on a free key, where the CLI's own
# default Flash model has ~20).
# AGENT_MODEL=

# --batch only: an older name for the model passed to the CLI via --model.
# When set it overrides AGENT_MODEL on that path; leave both unset to use the
# CLI's own default (gemini: the registry's, as above). The model must support
# tool-calling — the agent reads and writes files as part of the evaluation.
# Without tool use the evaluation will be incomplete.
# OLLAMA_MODEL=qwen2.5:32b

# ── Batch evaluation (--evaluate-batch) ──
# Provider for --evaluate-batch. Auto-detected from API keys below if not set.
# Options: anthropic | gemini | openai | groq | deepinfra | openrouter | deepseek | ollama
# Auto-detect order (cheapest first): gemini → groq → deepinfra → openrouter
#                                     → deepseek → openai → anthropic
# BATCH_PROVIDER=deepinfra

# Model name. Defaults to the provider's recommended model if not set.
# After changing any model below, run `python -m pipeline.verify_models` to
# confirm each configured ID still exists in its provider's catalog — a stale
# model ID fails silently at call time.
#
# IMPORTANT for Gemini free-tier users: free-tier capacity varies a lot by
# model, and it is not the RPD alone — TPM (tokens/minute) binds first on the
# Gemma rows, because an evaluation prompt is a whole JD plus your profile.
# Check yours at https://aistudio.google.com/rate-limit; run
# `python -m pipeline.gemini_limits --show` to print what is in effect here,
# including which rows are TPM-bound and which model it recommends. Free-tier
# figures as of 2026-08 (the batch run warns if a run would exceed them):
#   gemini-2.5-flash       =  20 RPD                (too low for >20 jobs/day)
#   gemini-3.5-flash       =  20 RPD
#   gemini-3.1-flash-lite  = 500 RPD
#   gemma-4-31b-it         = 14.4K RPD, 16K TPM → ~2.4K evaluations/day
#   gemma-4-26b-a4b-it     = 14.4K RPD, 16K TPM → ~2.4K evaluations/day
#                                                 ← best for batch evaluations
# For a 200+ job daily run, override the default:
#   BATCH_MODEL=gemma-4-26b-a4b-it
# BATCH_MODEL=gemini-2.5-flash

# Gemini free-tier conforming. When true, evaluation + résumé tailoring pace
# requests to the model's RPM and TPM, and each eval run caps to its RPD
# (deferring the rest to the next run), so you stay within the free tier instead
# of 429-ing. On a TPM-bound model the token budget is what sets the pace, so
# runs are slower than the RPM alone suggests — that is conformance working.
# No-op for paid models / other providers. The Setup wizard sets this.
#
# Conforming can only act on a model whose limits it knows. Google changes both
# the lineup and the numbers, and the built-in table is free-tier only — so if
# your model isn't in it, the run says so and paces nothing. Put your project's
# real numbers (aistudio.google.com/rate-limit) in config/gemini-limits.json:
#   {"gemini-3.1-flash-lite": {"rpm": 15, "tpm": 250000, "rpd": 1000}}
# The Setup wizard writes that file; `python -m pipeline.gemini_limits --show`
# prints what's in effect, and `--check-models` diffs the table's IDs against
# the live catalogue.
# GEMINI_FREE_TIER=false

# Where your own Gemini limits live (default: config/gemini-limits.json).
# GEMINI_LIMITS_FILE=config/gemini-limits.json

# Parallel workers for --evaluate-batch (default: 3).
# Lower for providers with strict rate limits; higher for paid tiers.
# BATCH_CONCURRENCY=3

# Anthropic — for --evaluate-batch with provider=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — free tier available on gemini-2.5-flash and similar models.
# gemini-2.0-flash is deprecated (shutdown 2026-06-01) and effectively NOT
# on the free tier — leave BATCH_MODEL unset to get the working default.
# GEMINI_API_KEY=AIza...

# OpenAI
# OPENAI_API_KEY=sk-...

# Escape hatch: point the openai provider at any OpenAI-compatible endpoint
# (local vLLM server, internal proxy, or any provider we haven't added
# explicitly above). Leave unset to use OpenAI's default api.openai.com.
# OPENAI_BASE_URL=https://my-internal-proxy.example.com/v1

# DeepInfra — hosted open-weight models (Llama, DeepSeek, Qwen, Mistral)
# served via OpenAI-compatible API. Sign up at https://deepinfra.com
# DEEPINFRA_API_KEY=...

# OpenRouter — meta-aggregator routing to many providers behind one API.
# Useful for A/B testing different models without re-doing setup.
# Sign up at https://openrouter.ai
# OPENROUTER_API_KEY=sk-or-...

# DeepSeek — the model maker's own API (OpenAI-compatible), cheaper than DeepInfra
# hosting the same weights — good for high-volume eval. Sign up at platform.deepseek.com.
# Use BATCH_PROVIDER=deepseek + BATCH_MODEL=deepseek-chat (or a specific version id).
# DEEPSEEK_API_KEY=sk-...

# Groq — free tier with fast inference on open-source models.
# Tight TPM limit on the free tier makes it best for small runs.
# GROQ_API_KEY=gsk_...

# Ollama — local models, no API key needed (install ollama.com).
# Only viable for local runs — GHA workflow can't reach localhost.
# OLLAMA_BASE_URL=http://localhost:11434

# ── Triage UI: career-ops skills (resume tailoring, etc.) ──
# When you run a skill from the UI you can use the API (provider keys above) or
# your agent CLI (BATCH_CLI above). Default below decides which the UI uses:
#   ask = let you choose each time (recommended) | api = always API | cli = always CLI
# Useful if you'd rather spend an agent-CLI membership than API credits, or mix
# (API for batch scoring, CLI for tailoring). Defaults to "ask".
# SKILL_PATH_DEFAULT=ask

# Path to the GitHub CLI (`gh`). Normally the UI auto-resolves it via PATH
# (shutil.which honors PATHEXT). Set this only if auto-resolution fails — e.g.
# when gh ships as a Microsoft Store "App Execution Alias" that CreateProcess
# can't follow, or the UI was launched from an environment without gh on PATH.
# Windows example:
# GH_BIN=C:\Program Files\GitHub CLI\gh.exe

# ── Triage UI on your home network (optional) ──
# By default the UI binds 127.0.0.1 and refuses any cross-origin POST: only this
# machine can reach it, so it needs no password. `./run-ui.sh --lan` (Windows:
# `./run-ui.ps1 -Lan`) binds 0.0.0.0 instead, so you can triage from a phone on
# the same network — and that is a different security question, answered here.
#
# UI_LAN turns the mode on. It is set BY the launcher; setting it here means
# "every run-ui is a LAN run", which is rarely what you want.
# UI_LAN=1
#
# UI_PASSWORD is REQUIRED under UI_LAN and is checked on every request (HTTP
# Basic — any username, this password). Both the launcher and the server refuse
# to start without it, from the two sides: the launcher cannot read this file,
# the server can, so a password kept only here satisfies the server and the
# launcher still wants it exported. Basic auth over plain HTTP is for a network
# you trust — stop the server before joining another one.
# UI_PASSWORD=a-long-passphrase
#
# UI_ALLOWED_HOSTS is the comma-separated list of names/addresses a LAN browser
# may use in the URL bar. Left unset, the server works them out once at startup
# (this machine's hostname and its non-loopback IPv4s) and prints what it
# accepted; set it when that guess is wrong or you use a name it can't know.
# It exists to stop a page on some other site from driving this one through
# your browser: a request whose Origin or Host is not in this set is refused.
# UI_ALLOWED_HOSTS=192.168.1.10,my-laptop.local
#
# From the LAN, the UI can move a card between columns and push that to the
# cloud — nothing else. Reset, Update, running the pipeline, the Setup wizard,
# launching an agent and the hand-off build stay loopback-only: they run
# programs and rewrite config, which is not what a phone is for.

# ── Browser-agent handoff ──
# Applying is done by YOUR browser agent (Claude Cowork, OpenClaw, a local
# Agent-SDK runner, …), not by this pipeline. `--handoff` (or the UI's
# 🤝 Hand off button) builds one work-order per job site the scraper searches
# from: next-roles-<site>.jsonl + .md (e.g. next-roles-linkedin.jsonl), so the
# agent can work one site session at a time.
#
# Where the work-orders land (default: output/handoff). Easiest set via the Setup
# wizard's "Browser-agent handoff folder" field (it writes this key AND creates +
# seeds the folder with a README the agent follows); or set it here by hand. Point
# it at a folder your agent can actually reach — e.g. the directory a desktop-agent
# session is connected to — so it sees the next-roles-<site>.jsonl files without copying.
# HANDOFF_OUT_DIR=C:\path\your\agent\can\read
# If you keep a JOB_LOG.md-style prose log from agent sessions, point the
# reconciler at it here so recorded applications/skips never reappear.
# HANDOFF_JOB_LOG=C:\path\to\JOB_LOG.md
# What your agent does at the Submit button. The default sends nothing without
# you seeing it: the agent fills and reviews the form, stops, and records
# `ready-to-submit`; that row comes back at the top of its work-order on every
# run until you click Submit and record `applied`. One of (id, then what it does):
#   stop-before-submit   fill and review every application, stop before Submit and record ready-to-submit; you click Submit and record applied
#   submit-easy-apply   submit only rows marked easy_apply (Indeed Apply, LinkedIn Easy Apply); everything else stops before Submit as ready-to-submit
#   submit-all   submit every application the agent prepares, then record applied
HANDOFF_SUBMIT_POLICY=stop-before-submit


# ── Daily digest (cloud) ──
# After every cloud run, the daily workflow tells you what is worth your
# attention: one Discord message and/or one email naming the roles that scored
# at or above the minimum, with the evaluator's verdict, the posting link and
# the reports attached; a one-line notice when the run failed; a heartbeat when
# nothing qualified. The Setup wizard writes all of these for you.
#
# Delivery goes in repository SECRETS (Settings → Secrets and variables →
# Actions). Either channel alone is enough; unset ones are skipped.
#   Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
#   Email: STARTTLS on port 587; Gmail needs an App Password (2-step on).
#          FROM defaults to the SMTP user; PORT defaults to 587.
# DIGEST_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# DIGEST_EMAIL_TO=you@example.com
# DIGEST_SMTP_HOST=smtp.gmail.com
# DIGEST_SMTP_PORT=587
# DIGEST_SMTP_USER=you@gmail.com
# DIGEST_SMTP_PASS=an-app-password
# DIGEST_EMAIL_FROM=you@gmail.com
#
# Tuning goes in repository VARIABLES (same page → Variables tab), one line
# each below with its default — the workflow falls back to exactly these:
#   DIGEST_MIN_SCORE=4.0
#   DIGEST_LIMIT=10
#   DIGEST_ALWAYS=true
#   DIGEST_ATTACH_REPORTS=true
#   DIGEST_NEXT_STEP=
# (ALWAYS: send the heartbeat when nothing qualifies. ATTACH_REPORTS: attach
# the qualifying reports as one digest-<date>.md. NEXT_STEP: replace the
# closing "open the UI, Refresh, Hand off" line.) Locally, the same names in
# this file drive `python -m pipeline.daily_digest --root career-ops
# --manifest <file>` — the digest exits 0 whatever happens.
