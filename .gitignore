# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node (career-ops uses node — installed locally by setup script)
node_modules/

# Local env / secrets
.env
.env.local

# User-specific config (the .example.yml is committed)
config/search.yml
# Local-only search override — diverges local runs from the cloud-shared config
config/search.local.yml

# Pipeline outputs
output/

# Throwaway local test/spike drivers (never committed)
scratch_*.py

# Playwright MCP session artifacts (page snapshots from agentic runs)
.playwright-mcp/

# Local UI artifact cache (populated by the Refresh button via `gh run download`)
.ui-cache/

# Temporary artifact downloads (ad-hoc inspection, never committed)
tempartifact-inspect/

# Setup logs
setup.log

# career-ops install (cloned by setup script, not vendored)
career-ops/

# User resumes
resumes/
*.pdf

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local session/config (per-user, not for the repo)
.claude/
